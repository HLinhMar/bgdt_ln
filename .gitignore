Thumbs.db
desktop.ini
ehthumbs.db

# Trình soạn thảo
.vscode/
.idea/
*.swp
*.swo

# Node (nếu sau này dùng công cụ build)
node_modules/
package-lock.json
.env
.env.*

# Netlify
.netlify/
