# tuyệt đối không để lọt lên repo công khai hay bản deploy Netlify.
_backup/
*_backup/
*.bak
*.orig

# Bản nháp, file tạm
_draft/
_tmp/
*.tmp
~$*

# Rác hệ điều hành
